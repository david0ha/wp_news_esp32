# OMC (oh-my-claudecode) local state — not for committing
.omc/

# Superpowers SDD working state: briefs, reports, review diffs and the ledger for
# whichever plan is being executed. Per-run scaffolding, not the plan or the spec,
# which are committed under docs/superpowers/. This was excluded through
# .git/info/exclude, which lives in one clone and nowhere else, so on any other
# checkout the whole directory showed up untracked and one `git add -A` would
# have committed it.
.superpowers/

# ESP-IDF build artifacts
build/
sdkconfig.old
# Generated per-developer config (may hold a WiFi password) — never commit. Shared config goes in sdkconfig.defaults
sdkconfig
# ...and the copies made by hand before switching IDF versions. `sdkconfig.old`
# is the one idf.py writes; a person reaching for a backup names it whatever
# they like, and the rule is about the contents, not the suffix.
sdkconfig.bak*
*.pyc
__pycache__/

# Dependencies fetched by the ESP-IDF component manager (regenerable)
managed_components/
dependencies.lock

# LVGL simulator screenshot artifacts
sim/shots/
shots/

# Claude Code local state / git worktree — not for committing
.claude/

# clangd / editor index caches
.cache/

# macOS
.DS_Store

# host test/sim run logs
*.log

# Assembled by agent/standalone/publish.sh from the current edition, and rebuilt
# from empty every run. A build product of the desk, not source.
agent/standalone/public/

# local secrets — never commit
.env
.env.*
# ...except the template, which is the file that documents every knob and holds
# no value for any of them. It has to be committed or nobody knows what to set.
!.env.example

.worktrees/
