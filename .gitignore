# OMC (oh-my-claudecode) local state — not for committing
.omc/

# ESP-IDF build artifacts
build/
sdkconfig.old
# Generated per-developer config (may hold a WiFi password) — never commit. Shared config goes in sdkconfig.defaults
sdkconfig
*.pyc
__pycache__/

# Dependencies fetched by the ESP-IDF component manager (regenerable)
managed_components/
dependencies.lock

# LVGL simulator screenshot artifacts
sim/shots/
shots/

# Claude Code local state / git worktree — not for committing
.claude/

# clangd / editor index caches
.cache/

# macOS
.DS_Store

# host test/sim run logs
*.log

# Assembled by agent/standalone/publish.sh from the current edition, and rebuilt
# from empty every run. A build product of the desk, not source.
agent/standalone/public/

# local secrets — never commit
.env
.env.*
# ...except the template, which is the file that documents every knob and holds
# no value for any of them. It has to be committed or nobody knows what to set.
!.env.example

.worktrees/
