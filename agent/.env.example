# agent/.env — copy to agent/.env and fill in. Never commit the filled copy.
#
# Nothing secret belongs here. The producer token and the API key live in
# ~/.claudepost/agent.env, outside the repository, mounted read-only. What this
# file holds is *where things are*, which is personal without being
# confidential.

# Where the desk is.
#
#   http://desk:8080                     the desk on the shared `claudepost`
#                                        docker network — the default, and
#                                        what you want when both halves are on
#                                        this machine. Needs
#                                        `docker network create claudepost`
#                                        first.
#   http://host.docker.internal:8790     the desk published on the host's
#                                        loopback, on Docker Desktop. On Linux
#                                        this name needs an `extra_hosts` entry.
#   https://your-hostname/               the desk through its tunnel — which is
#                                        how a worker on another machine reaches
#                                        it, and is the reason this is a
#                                        variable at all.
# Empty means each arrangement's own default: http://desk:8080 in the
# container, http://127.0.0.1:8790 under agent/run-host.sh. Filling in the
# container's hostname here would follow the file onto a host run, where it
# resolves to nothing and the claim loop backs off forever.
CLAUDEPOST_DESK=

# A directory on THIS machine holding whatever you want in front of the model
# on every run: a house style, a rotation, a list of things that must never
# print. Any flat .md or .json files directly in it are appended to the prompt
# under their own names, in sorted order; subdirectories are not read.
#
# Nothing in this repository knows what is in it. agent/context.example/ is a
# set of empty templates to copy somewhere and start from.
#
# Setting this alone does nothing: the volume line in agent/compose.yaml that
# mounts it is commented out, because a default here would be somebody's disk.
# Uncomment it too.
AGENT_CONTEXT_DIR=

# Whether the worker may append a note to <context>/briefs/<date>.md saying what
# it filed and why. Off by default, and it needs a context directory to be
# mounted read-write as well: pointing this worker at your notes is a decision
# to have it read them, and deciding on your behalf that it may also write into
# them is not this repository's to make.
AGENT_WRITE_BRIEFS=0

# The tool allowlist handed to `claude --print`. Empty means the image's
# default, which is reads, writes, search, and the two repository scripts the
# contract names. This is where a market-data MCP goes — which one to trust is
# your decision and your credential, so there is none in the default:
#   AGENT_TOOLS=Read,Write,Edit,Glob,Grep,WebSearch,WebFetch,mcp__your_broker__*,Bash(python3 {repo}/tools/make_tile.py:*),Bash(python3 {repo}/tools/mock_news_server.py:*)
# {repo} is substituted with the repository root inside the container.
AGENT_TOOLS=

# Whether to keep this machine's own MCP servers out of the headless child.
# On by default and it matters most outside a container: a worker run by
# agent/run-host.sh inherits the operator's whole MCP configuration, and the
# first live run of that arrangement loaded a browser-automation server and
# spent twelve minutes browsing instead of filing. It did not fail — it
# wandered, which is worse, because a failure is a log line and this is a
# morning with no paper.
#
# The allowlist does not cover this: it decides what may run without asking,
# not what is loaded. Set 0 to let them in for market data, and then name each
# tool in AGENT_TOOLS — a wildcard on a brokerage server includes its order
# routes, and a producer that can trade is not a producer.
AGENT_STRICT_MCP=1

# Where the candidates and the rotation cursor live. Empty means
# <CLAUDEPOST_SECRETS>/watchlist.json — right for a host run, where that
# directory is the operator's own and writable, and it is the file for your
# own morning job to refresh. In the container the same default is READ-ONLY
# (compose mounts the secrets ro, correctly: they hold the token), so the
# cursor never advances there; point this at a writable mount if a container
# should keep the rotation itself.
CLAUDEPOST_WATCHLIST=

# Handle one instruction and exit instead of staying resident. Off for a
# container or a launchd KeepAlive job; on for `run-host.sh --once` and for a
# calendar job that fires after the morning order.
CLAUDEPOST_ONCE=0

# The child inherits this machine's Claude Code plugins/orchestration layer
# unless loop.py's child_env() keeps it out (DISABLE_OMC) — which it does by
# default. 1 leaves your own setup in force inside the child.
CLAUDEPOST_KEEP_PLUGINS=0

# An API key beside a CLI login is dropped from the child so the subscription
# pays; 1 says "spend the metered key" in so many words.
CLAUDEPOST_USE_API_KEY=0

# INFO logs one line per claim and one per commit.
# DEBUG adds the whole `claude --print` transcript, which is long.
CLAUDEPOST_LOG_LEVEL=INFO

# The zone the container reports times in. It stamps the log and the date a
# brief is filed under; the schedule is the desk's and carries its own.
TZ=UTC
