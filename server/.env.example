# server/.env — copy to server/.env and fill in. Never commit the filled copy.
#
# Nothing secret belongs here. Tokens live in ~/.wpnews/tokens.json and the
# agent's API key in ~/.wpnews/agent.env, both outside the repository and both
# mounted read-only. What this file holds is *where things are*, which is
# personal without being confidential.

# The private half of the desk: one subdirectory of the owner's vault, mounted
# read-write at /vault. NOT the whole vault — this container answers the
# internet, and the vault is the owner's whole second brain. The desk creates
# the layout inside it on first start and never overwrites anything.
#   e.g. /Volumes/ssd/ObsidianBrain/02_areas/investing/wpnews
WPNEWS_VAULT=

# The hostname the board will poll. Used only by the tunnel config you copy to
# ~/.cloudflared/wpnews.yml; nothing in the desk reads it.
#   e.g. wpnews.example.dev
WPNEWS_HOSTNAME=

# How many past editions to keep on the serving volume. The current and the
# staged edition are always kept regardless.
WPDESK_KEEP_EDITIONS=30

# INFO logs one line per publish and one per vault-availability change.
# DEBUG additionally logs every request, which on a board polling every fifteen
# minutes forever is a lot of lines saying nothing happened.
WPDESK_LOG_LEVEL=INFO

# The zone the containers report times in. The schedule carries its own
# timezone; this only affects log timestamps.
TZ=Asia/Seoul
