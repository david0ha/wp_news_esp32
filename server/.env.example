# server/.env — copy to server/.env and fill in. Never commit the filled copy.
#
# Nothing secret belongs here. Tokens live in ~/.claudepost/tokens.json and the
# agent's API key in ~/.claudepost/agent.env, both outside the repository and both
# mounted read-only. What this file holds is *where things are*, which is
# personal without being confidential.

# The hostname the board will poll. Used only by the tunnel config you copy to
# ~/.cloudflared/claudepost.yml; nothing in the desk reads it.
#   e.g. claudepost.example.dev
CLAUDEPOST_HOSTNAME=

# How many past editions to keep on the serving volume. The current and the
# staged edition are always kept regardless.
CLAUDEPOST_KEEP_EDITIONS=30

# INFO logs one line per publish, plus a handful at startup.
# DEBUG additionally logs every request, which on a board polling every fifteen
# minutes forever is a lot of lines saying nothing happened.
CLAUDEPOST_LOG_LEVEL=INFO

# The zone the containers report times in. Set it to your own zone, the same
# one as in agent/.env, so the two logs read together. The schedule carries
# its own timezone field and does not read this.
TZ=UTC
