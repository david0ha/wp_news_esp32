# Shared project configuration. Per-developer settings (and anything secret)
# belong in the generated `sdkconfig`, which is gitignored.
#
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FREERTOS_HZ=1000

# Every glyph on this board comes from the seven generated newspaper faces in
# components/news_core/fonts/ (see ui_fonts.h). Montserrat 14 is kept for one
# reason only: LVGL's LV_FONT_DEFAULT choice offers built-in faces and nothing
# else, and a display created before that symbol resolves will not link. Nothing
# is actually drawn with it — every helper in ui_internal.h takes its font
# explicitly — so the other four sizes this board used to carry are gone.
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y

# LVGL allocates its widgets from the PSRAM, through the nine functions in
# components/app_bsp/lvgl_mem_psram.c, rather than from the 64 KB static pool in
# internal .bss that LV_USE_BUILTIN_MALLOC defaults to. The front page is 390
# objects and 197,096 bytes the moment ui_news_create() returns — measured, in
# the simulator, against this exact UI code — peaking at 202,672 across both
# pages and the overlays. That is three times the default pool, and it does not
# fit in ANY internal pool: the boot log leaves about 186 KiB of internal DRAM
# free once the 64 KB pool has been reserved, and Wi-Fi and mbedTLS have to come
# out of what remains.
#
# Getting this wrong does not report itself. lv_obj_class_create_obj() stores
# into the result of an unchecked lv_realloc(), so a full LVGL heap arrives as a
# StoreProhibited on a small address, in whichever widget happened to be next.
CONFIG_LV_USE_CUSTOM_MALLOC=y
# CONFIG_LV_USE_BUILTIN_MALLOC is not set

# The news snapshot normally comes from a machine on the same LAN over plain
# HTTP, so no certificate is involved at all. An https:// URL still works and
# validates against IDF's default bundle; the fortune board this forked from
# carried a custom bundle for a specific weather API, which has no successor
# here and would only be a stale root to maintain.
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_ESP_TLS_CLIENT_SESSION_TICKETS=y

# Task Watchdog: bump from the 5s default to 10s. Two things here legitimately
# hold a core for seconds — an ECDSA cert verify on an https:// news URL
# (mbedtls_mpi_mul_mpi busy-polls the MPI peripheral with no interrupt path),
# and a full 648x480 e-Paper refresh. Neither is a hung task (PANIC stays off),
# so widen the window rather than mask it.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# app_main renders the full LVGL screen (provisioning drives the setup overlay
# with Lvgl_RenderNow + epd_refresh_full on the main task) — the IDF default of
# 3584 bytes overflows there, reproducibly, right at the first Wi-Fi connect.
# 8 KB matches UiTask, which exists to run exactly the same render path.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# The Wi-Fi event task runs provisioning's scan-done handler; the IDF default
# of 2304 bytes left it one log call away from overflow even after the handler
# stopped keeping buffers on its stack. Headroom, cheap at 8 MB PSRAM.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# Phone browsers send >512 bytes of request headers to the captive portal;
# esp_http_server's default rejects the setup form with a 431
# ("Header fields are too long") before our handler ever runs.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048

# Seeed EE04: GPIO43/44 (default UART0 TX/RX) are the e-Paper power-enable and
# CS lines, so the console must live on USB Serial/JTAG — a UART0 console would
# clock log bytes straight into the panel control pins.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
